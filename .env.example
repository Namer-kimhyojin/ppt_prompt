NODE_ENV=production
PROMPTDECK_PUBLIC_BASE_URL=https://promptdeck.example.com
PROMPTDECK_SECURE_COOKIES=true
PROMPTDECK_TRUST_PROXY=true
PROMPTDECK_BOOTSTRAP_ADMIN_USERNAME=admin
PROMPTDECK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD_123!
PROMPTDECK_OPERATOR_NAME=운영자 또는 법인명
PROMPTDECK_REPRESENTATIVE_NAME=
PROMPTDECK_BUSINESS_NUMBER=
PROMPTDECK_OPERATOR_ADDRESS=실제 사업장 주소
PROMPTDECK_PRIVACY_OFFICER=개인정보 보호책임자 성명
PROMPTDECK_PRIVACY_EMAIL=privacy@example.com
PROMPTDECK_PRIVACY_PHONE=
PROMPTDECK_SERVICE_REGION=대한민국
PROMPTDECK_SMTP_PROVIDER=사용 중인 메일 제공자
PROMPTDECK_OUTPUT_RETENTION_DAYS=30
PROMPTDECK_AUDIT_RETENTION_DAYS=365
PROMPTDECK_AUTH_ENABLED=false
PROMPTDECK_ALLOW_SIGNUPS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

IMAGE_PROVIDER=mock
PROMPTDECK_ALLOW_PREVIEW_MODELS=false
PROMPTDECK_ALLOW_POLLINATIONS=false
PROMPTDECK_GOOGLE_PAID_SERVICE_CONFIRMED=false
PROMPTDECK_AI_DATA_TRANSFER_CONFIRMED=false
PROMPTDECK_UNSPLASH_DATA_TRANSFER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
