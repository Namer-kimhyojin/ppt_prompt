# 자동 테스트 전용 가상 값. 실제 배포에 사용하지 않는다.
NODE_ENV=production
PROMPTDECK_PUBLIC_BASE_URL=https://promptdeck.test
PROMPTDECK_SECURE_COOKIES=true
PROMPTDECK_TRUST_PROXY=true
PROMPTDECK_BOOTSTRAP_ADMIN_USERNAME=deploy-check-admin
PROMPTDECK_BOOTSTRAP_ADMIN_PASSWORD=Fixture-Only-Strong-2026!
PROMPTDECK_OPERATOR_NAME=사전점검 테스트 운영자
PROMPTDECK_OPERATOR_ADDRESS=테스트시 테스트로 1
PROMPTDECK_PRIVACY_OFFICER=사전점검 담당자
PROMPTDECK_PRIVACY_EMAIL=privacy@promptdeck.test
PROMPTDECK_OUTPUT_RETENTION_DAYS=30
PROMPTDECK_AUDIT_RETENTION_DAYS=365
PROMPTDECK_ALLOW_SIGNUPS=false
IMAGE_PROVIDER=mock
PROMPTDECK_ALLOW_PREVIEW_MODELS=false
PROMPTDECK_ALLOW_POLLINATIONS=false
PROMPTDECK_GOOGLE_PAID_SERVICE_CONFIRMED=false
PROMPTDECK_AI_DATA_TRANSFER_CONFIRMED=false
